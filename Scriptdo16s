local function createToggle(text, default, changed, key)
    local row = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Colors.Surface,
        AutoButtonColor = false,
        Text = "",
        BorderSizePixel = 0,
