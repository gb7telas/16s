--=====================================================================
-- HELPERS
--=====================================================================
local function create(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local function corner(o, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = o
    return c
end

local function stroke(o, color, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or Colors.Stroke
    s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = o
    return s
end

local function tween(o, props, t)
    local tw = TweenService:Create(o, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function fmt(v)
    if math.abs(v - math.floor(v + 0.5)) < 0.01 then return tostring(math.floor(v + 0.5)) end
    return string.format("%.2f", v)
end

--=====================================================================
-- CLIQUE (VirtualInputManager: funciona em jogos com ContextAction,
-- Tool activate, bots, e é o método mais compatível entre executores)
--=====================================================================
local function doClick()
    local btn = (Config.Button == "Esquerdo") and 0 or 1
    local ok = pcall(function()
        -- mouse down + up na posição atual do mouse
        VirtualInputManager:SendMouseButtonEvent(
            UIS:GetMouseLocation().X,
            UIS:GetMouseLocation().Y,
            btn, true, game, 0
        )
        VirtualInputManager:SendMouseButtonEvent(
            UIS:GetMouseLocation().X,
            UIS:GetMouseLocation().Y,
            btn, false, game, 0
        )
    end)
    if not ok then
        -- fallback raro: some executores sem VIM
        pcall(function()
            mouse1press and mouse1press()
            mouse1release and mouse1release()
        end)
    end
end

--=====================================================================
-- LOOP DE CLIQUE ( Heartbeat p/ precisão de CPS )
--=====================================================================
local totalClicks = 0

local function clickInterval()
    local base = 1 / math.max(Config.CPS, 0.1)
    if Config.Randomize and Config.RandomAmount > 0 then
        local f = Config.RandomAmount / 100
        return base * (1 - f + math.random() * f * 2)
    end
    return base
end

conns[#conns + 1] = RunService.Heartbeat:Connect(function(dt)
    local shouldClick = Config.Enabled and (
        Config.HoldMode and State.holdDown or State.toggleOn
    )

    if not shouldClick then
        State.nextClick = 0
        return
    end

    State.nextClick = State.nextClick - dt
    if State.nextClick <= 0 then
        doClick()
        totalClicks = totalClicks + 1
        State.nextClick = clickInterval()
    end
end)

