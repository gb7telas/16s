    corner(row, 8)

    create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Colors.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local track = create("Frame", {
        Size = UDim2.fromOffset(36, 18),
        Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = Colors.Surface2,
        BorderSizePixel = 0,
    }, row)
    corner(track, 9)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Colors.Text,
        BorderSizePixel = 0,
    }, track)
    corner(knob, 7)

    local state = default and true or false
    local function render(anim)
        local kp = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        local tc = state and Colors.Accent or Colors.Surface2
        if anim then
            tween(knob, { Position = kp }, 0.15)
            tween(track, { BackgroundColor3 = tc }, 0.15)
        else
            knob.Position = kp
            track.BackgroundColor3 = tc
        end
    end

    local api = {}
    function api.Set(v, fire)
        state = v and true or false
        render(true)
        if fire ~= false and changed then changed(state) end
    end
    function api.Get() return state end

    render(false)
    if key then Refs[key] = api end
    row.MouseButton1Click:Connect(function() api.Set(not state, true) end)
    return api
end

local function createSlider(text, min, max, default, suffix, changed, key)
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = Colors.Surface,
        BorderSizePixel = 0,
    }, page)
    corner(row, 8)

    create("TextLabel", {
        Size = UDim2.new(1, -100, 0, 18),
        Position = UDim2.fromOffset(12, 6),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Colors.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local valueLabel = create("TextLabel", {
        Size = UDim2.fromOffset(76, 18),
        Position = UDim2.new(1, -88, 0, 6),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Colors.Accent,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local track = create("Frame", {
        Size = UDim2.new(1, -24, 0, 4),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundColor3 = Colors.Surface2,
        BorderSizePixel = 0,
    }, row)
    corner(track, 2)

    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Colors.Accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 2)
    local fg = Instance.new("UIGradient")
    fg.Color = ColorSequence.new(Colors.Accent, Colors.Accent2)
    fg.Parent = fill

    local knob = create("Frame", {
        Size = UDim2.fromOffset(12, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Colors.Text,
        BorderSizePixel = 0,
    }, track)
    corner(knob, 6)

    local hit = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0.5, -10),
        BackgroundTransparency = 1,
        Text = "",
    }, track)

    local value = default
    local dragging = false

    local function set(v, fire)
        value = math.clamp(v, min, max)
        local rel = (max - min) ~= 0 and (value - min) / (max - min) or 0
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valueLabel.Text = fmt(value) .. (suffix or "")
        if fire ~= false and changed then changed(value) end
    end

    local function fromInput(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        set(min + rel * (max - min))
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(input)
        end
    end)
    conns[#conns + 1] = UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end)
    conns[#conns + 1] = UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local api = {}
    function api.Set(v, fire) set(v, fire) end
    function api.Get() return value end
    set(default, false)
    if key then Refs[key] = api end
    return api
end

