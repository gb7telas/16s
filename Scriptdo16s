    }, row)
    corner(btn, 6)

    local current = defaultKey
    local listening = false
    local api = {}

    btn.MouseButton1Click:Connect(function()
        listening = true
        State.listeningKey = true
        btn.Text = "..."
        btn.TextColor3 = Colors.Accent
    end)

    conns[#conns + 1] = UIS.InputBegan:Connect(function(input)
        if listening and input.KeyCode ~= Enum.KeyCode.Unknown then
            listening = false
            State.listeningKey = false
            current = input.KeyCode
            btn.Text = current.Name
            btn.TextColor3 = Colors.Text
            if changed then changed(current) end
        end
    end)

    function api.Set(v, fire)
        current = v
        btn.Text = v.Name
        if fire ~= false and changed then changed(v) end
    end
    function api.Get() return current end
    if key then Refs[key] = api end
    return api
end

